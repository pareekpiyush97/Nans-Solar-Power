# ---------------------------------------------------------------------------
# PUBLIC config only — safe to commit. These values ship to the browser.
# NEVER put secrets here (OAuth client SECRET, admin password, admin API keys).
# Those live ONLY in the Pocketbase server settings.
# ---------------------------------------------------------------------------

# Your Pocketbase instance (public base URL)
VITE_POCKETBASE_URL=https://your-pocketbase-host.example.com

# Google OAuth *client ID* (public, safe to expose). The client SECRET stays on Pocketbase.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
